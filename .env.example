# Application
APP_NAME="Ledger API"
APP_ENV="development"
APP_DEBUG=true
APP_HOST="127.0.0.1"
APP_PORT=8000

# API Routing
API_V1_PREFIX="/api/v1"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ledger_db"

# Logging
LOG_LEVEL="INFO"
